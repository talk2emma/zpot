# Copy to mobile/.env. Values are compiled into the JS bundle by `npm run env` — PUBLIC VALUES ONLY.
# Leave API URLs empty to use platform defaults:
#   Android emulator -> http://10.0.2.2:8000/api/v1   (or use `adb reverse tcp:8000 tcp:8000` + localhost)
#   iOS simulator    -> http://localhost:8000/api/v1
#   Physical device  -> set your Mac's LAN IP, e.g. http://192.168.1.20:8000/api/v1
ZPOT_API_URL_ANDROID=
ZPOT_API_URL_IOS=
# Map: Mapbox Maps SDK (see docs/development/maps.md). Without a pk.* token the app reports the map as unavailable.
# Mapbox style URL
ZPOT_MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
# Public Mapbox token (pk.*) with public scopes only; it ships inside the app. Never put sk.* secrets here (gen-env rejects them).
ZPOT_MAPBOX_PUBLIC_TOKEN=
ZPOT_REQUEST_TIMEOUT_MS=12000
ZPOT_SHOW_DEV_TOOLS=true
