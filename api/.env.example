# --- Django -----------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=local-dev-only-change-me-0123456789abcdefghij
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,0.0.0.0,api
CORS_ALLOWED_ORIGINS=http://localhost:8081

# --- Database (PostGIS) -----------------------------------------------------
DATABASE_URL=postgis://zpot:zpot@db:5432/zpot

# --- Redis / Celery ---------------------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# --- Email (local capture via Mailpit: UI http://localhost:8025) -------------
EMAIL_HOST=mailpit
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Zpot <no-reply@zpot.local>
# Deep-link base used in verification / password-reset emails
APP_LINK_BASE=zpot://
WEB_LINK_BASE=http://localhost:8000

# --- JWT --------------------------------------------------------------------
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Geocoding --------------------------------------------------------------
# local = development gazetteer stored in PostGIS (default, no external calls)
# nominatim = OpenStreetMap Nominatim (respect usage policy: max 1 req/s, set a contact UA)
GEOCODER_PROVIDER=local
NOMINATIM_USER_AGENT=zpot-dev/0.1 (set-a-contact-address)

# --- Maps (public values only; never put secret tokens here) ---------------
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Feature flags ----------------------------------------------------------
FEATURE_COMMUNITY_REPORTS=false
FEATURE_PARKING_SESSIONS=false
FEATURE_MONETISATION_CONCEPTS=false
FEATURE_Z_TRIGGER=false
FEATURE_SCOUTS=false

# --- Seed data --------------------------------------------------------------
# If unset, `seed_zpot_lisbon --with-users` generates random passwords and prints them once.
ZPOT_SEED_PASSWORD=
